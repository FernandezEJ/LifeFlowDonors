# Set the device-accessible Laravel API URL. Proof uploads use this authenticated API.
# For the standalone APK, set EXPO_PUBLIC_API_URL in the EAS preview environment
# to the deployed HTTPS Laravel URL including /api. Local ignored .env files
# are not uploaded to EAS; the existing LAN fallback is for local development only.
# This URL is bundled into the app and is public, not a place for credentials.
# Android FCM uses google-services.json; Firebase Web/Storage values are not needed.
EXPO_PUBLIC_API_URL=

# Public-facing support address for donor sign-in help. Leave blank until approved.
# When blank/invalid, the app shows configuration-pending guidance and no email link.
# Set in local .env for Expo Go; restart Expo after editing. Never add credentials.
EXPO_PUBLIC_LIFEFLOW_SUPPORT_EMAIL=
