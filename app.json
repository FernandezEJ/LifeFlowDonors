{
  "expo": {
    "name": "LifeFlow",
    "slug": "LifeFlow",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifeflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.lifeflow.capstone",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-lockup.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F2",
          "dark": {
            "image": "./assets/images/splash-lockup.png",
            "backgroundColor": "#FFF9F2"
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-status-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "important",
          "icon": "./assets/images/notification-icon.png",
          "color": "#892325"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f9d6b18-2943-43ef-be81-d9aa7d09d0aa"
      }
    },
    "owner": "flowies-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3f9d6b18-2943-43ef-be81-d9aa7d09d0aa"
    }
  }
}
